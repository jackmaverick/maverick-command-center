{
  "crons": [
    {
      "path": "/api/qbo/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/qbo/sheet-sync",
      "schedule": "10 12 * * *"
    },
    {
      "path": "/api/snapshots/generate?type=weekly",
      "schedule": "15 6 * * 1"
    },
    {
      "path": "/api/snapshots/generate?type=monthly",
      "schedule": "30 6 1 * *"
    }
  ]
}
