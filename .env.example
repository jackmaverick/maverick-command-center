# Supabase Postgres (server-only)
DATABASE_URL=postgresql://postgres:PASSWORD@db.example.supabase.co:5432/postgres

# Auth.js Google OAuth (server-only)
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Access policy. Domain is required; exceptions are optional and comma-separated.
AUTH_ALLOWED_DOMAIN=maverickexteriorskc.com
AUTH_ALLOWED_EMAILS=owner@example.com

# Existing scheduled endpoint protection
CRON_SECRET=replace-with-a-random-cron-secret

# v2b replies — keep false until Jack approves the first live test
REPLIES_ENABLED=false
REPLIES_ALLOWED_EMAILS=jack@maverickexteriorskc.com,michael@maverickexteriorskc.com

# OpenPhone text delivery and signed webhooks
OPENPHONE_API_KEY=replace-with-openphone-api-key
OPENPHONE_WEBHOOK_SECRET=replace-with-openphone-webhook-secret

# Gmail domain-wide delegation (JSON is preferred; split fields are supported)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"replace-me","private_key":"replace-me","client_id":"replace-me"}
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=replace-with-private-key
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=replace-with-oauth-client-id

# JobNimbus internal-note delivery
JOBNIMBUS_API_KEY=replace-with-jobnimbus-api-key
